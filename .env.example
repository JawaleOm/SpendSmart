# SpendSmart Environment Configuration Example
# Copy this file to .env for local overrides (never commit your actual .env)

# Flask Session Security Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# Optional: Path to custom SQLite database file
DATABASE_PATH=

# Optional: Hosted PostgreSQL database URL (e.g. Neon, Supabase, Vercel Postgres)
DATABASE_URL=
